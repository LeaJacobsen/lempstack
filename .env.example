# Example settings for the LEMP stack.
# Copy this file to ".env" and replace every value with your own.
# ".env" is git-ignored, so your real passwords never end up on GitHub.

# MariaDB
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=lemp_app
DB_USER=lemp_user
DB_PASSWORD=change-me-app-password

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
